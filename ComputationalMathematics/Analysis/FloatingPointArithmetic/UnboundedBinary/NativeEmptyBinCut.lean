import ComputationalMathematics.Analysis.FloatingPointArithmetic.UnboundedBinary.IntegerWords
import Mathlib.Tactic.Linarith
import Mathlib.Tactic.Ring
import Mathlib.Data.Fintype.Card
import Mathlib.Data.Nat.Find

/-!
# First empty-bin cuts and native binary endpoints

The first-empty-bin choice in this file is an exact mathematical selector,
not an executable sorted scan. Its endpoint words are generated by actual
rounded +1 stepping and exact binary scaling at the original precision p.
-/

namespace NumStability.FloatingPointFormat.UnboundedBinary

noncomputable section

/-- Half-open source bin [j*α,(j+1)*α). -/
def InCutBin (alpha : ℝ) (j : ℕ) (x : ℝ) : Prop :=
  (j : ℝ) * alpha ≤ x ∧ x < ((j + 1 : ℕ) : ℝ) * alpha

def EmptyCutBin {k : ℕ} (alpha : ℝ) (s : Fin k → ℝ) (j : ℕ) : Prop :=
  ∀ i, ¬ InCutBin alpha j (s i)

/-- k estimates cannot occupy each of the k+1 pairwise disjoint bins.
No sortedness, distinctness, or nonzero-estimate assumption is needed. -/
theorem exists_emptyCutBin {k : ℕ} (alpha : ℝ) (s : Fin k → ℝ) (halpha : 0 < alpha) :
    ∃ j : ℕ, 1 ≤ j ∧ j ≤ k + 1 ∧ EmptyCutBin alpha s j := by
  classical
  by_contra hnone
  have hocc : ∀ r : Fin (k + 1), ∃ i : Fin k, InCutBin alpha (r.val + 1) (s i) := by
    intro r
    by_contra h
    apply hnone
    refine ⟨r.val + 1, by omega, by omega, ?_⟩
    intro i hi
    exact h ⟨i, hi⟩
  choose f hf using hocc
  have hinj : Function.Injective f := by
    intro a b hab
    apply Fin.ext
    have ha := hf a
    have hb := hf b
    rw [hab] at ha
    unfold InCutBin at ha hb
    by_contra hne
    rcases lt_or_gt_of_ne hne with hab' | hba'
    · have habR : ((a.val + 2 : ℕ) : ℝ) ≤ ((b.val + 1 : ℕ) : ℝ) := by exact_mod_cast (by omega : a.val + 2 ≤ b.val + 1)
      have hmul := mul_le_mul_of_nonneg_right habR halpha.le
      push_cast at ha hb hmul
      linarith
    · have hbaR : ((b.val + 2 : ℕ) : ℝ) ≤ ((a.val + 1 : ℕ) : ℝ) := by exact_mod_cast (by omega : b.val + 2 ≤ a.val + 1)
      have hmul := mul_le_mul_of_nonneg_right hbaR halpha.le
      push_cast at ha hb hmul
      linarith
  have hcard := Fintype.card_le_of_injective f hinj
  simp only [Fintype.card_fin] at hcard
  omega

/-- Proof-only first empty bin. This Nat.find is not a native executable scan. -/
def firstEmptyCutBin {k : ℕ} (alpha : ℝ) (s : Fin k → ℝ) (halpha : 0 < alpha) : ℕ :=
  by classical exact Nat.find (exists_emptyCutBin alpha s halpha)

theorem firstEmptyCutBin_spec {k : ℕ} (alpha : ℝ) (s : Fin k → ℝ) (halpha : 0 < alpha) :
    1 ≤ firstEmptyCutBin alpha s halpha ∧ firstEmptyCutBin alpha s halpha ≤ k + 1 ∧
      EmptyCutBin alpha s (firstEmptyCutBin alpha s halpha) :=
  by classical exact Nat.find_spec (exists_emptyCutBin alpha s halpha)

/-- Every earlier source bin is occupied, giving exact FIRST-empty semantics. -/
theorem firstEmptyCutBin_min {k : ℕ} (alpha : ℝ) (s : Fin k → ℝ) (halpha : 0 < alpha)
    {j : ℕ} (hj : 1 ≤ j) (hbefore : j < firstEmptyCutBin alpha s halpha) :
    ∃ i, InCutBin alpha j (s i) := by
  classical
  have hjbound : j ≤ k + 1 := by have h := (firstEmptyCutBin_spec alpha s halpha).2.1; omega
  by_contra hempty
  have hbin : EmptyCutBin alpha s j := by intro i hi; exact hempty ⟨i, hi⟩
  exact Nat.find_min (exists_emptyCutBin alpha s halpha) hbefore ⟨hj, hjbound, hbin⟩

/-- In particular, estimates all below α (including all zero estimates) choose bin 1. -/
theorem firstEmptyCutBin_eq_one_of_below {k : ℕ} (alpha : ℝ) (s : Fin k → ℝ)
    (halpha : 0 < alpha) (hbelow : ∀ i, s i < alpha) : firstEmptyCutBin alpha s halpha = 1 := by
  classical
  have hempty : EmptyCutBin alpha s 1 := by
    intro i hi
    exact (not_le_of_gt (hbelow i)) (by simpa [InCutBin] using hi.1)
  have hle : firstEmptyCutBin alpha s halpha ≤ 1 :=
    Nat.find_min' (exists_emptyCutBin alpha s halpha) ⟨by omega, by omega, hempty⟩
  exact le_antisymm hle (firstEmptyCutBin_spec alpha s halpha).1

/-- Every estimate is strictly low or at/above the upper endpoint; ties go high. -/
theorem firstEmptyCutBin_dichotomy {k : ℕ} (alpha : ℝ) (s : Fin k → ℝ) (halpha : 0 < alpha)
    (i : Fin k) :
    s i < (firstEmptyCutBin alpha s halpha : ℝ) * alpha ∨
      ((firstEmptyCutBin alpha s halpha + 1 : ℕ) : ℝ) * alpha ≤ s i := by
  have he := (firstEmptyCutBin_spec alpha s halpha).2.2 i
  unfold InCutBin at he
  rcases lt_or_ge (s i) ((firstEmptyCutBin alpha s halpha : ℝ) * alpha) with h | h
  · exact Or.inl h
  · exact Or.inr (le_of_not_gt (by intro hupper; exact he ⟨h, hupper⟩))

/-- The low side is bounded by (k+1)*α≤2k*α for the source k≥1. -/
theorem low_estimate_bound {k : ℕ} (hk : 1 ≤ k) (alpha : ℝ) (s : Fin k → ℝ) (halpha : 0 < alpha)
    {i : Fin k} (hlow : s i < (firstEmptyCutBin alpha s halpha : ℝ) * alpha) :
    s i < (2 * k : ℝ) * alpha := by
  have hj := (firstEmptyCutBin_spec alpha s halpha).2.1
  have hle : firstEmptyCutBin alpha s halpha ≤ 2 * k := by omega
  have hleR : (firstEmptyCutBin alpha s halpha : ℝ) ≤ 2 * k := by exact_mod_cast hle
  exact hlow.trans_le (mul_le_mul_of_nonneg_right hleR halpha.le)

theorem high_estimate_ge_alpha {k : ℕ} (alpha : ℝ) (s : Fin k → ℝ) (halpha : 0 < alpha)
    {i : Fin k} (hhigh : ((firstEmptyCutBin alpha s halpha + 1 : ℕ) : ℝ) * alpha ≤ s i) :
    alpha ≤ s i := by
  have hj := (firstEmptyCutBin_spec alpha s halpha).1
  have hjR : (1 : ℝ) ≤ (firstEmptyCutBin alpha s halpha + 1 : ℕ) := by exact_mod_cast (by omega : 1 ≤ firstEmptyCutBin alpha s halpha + 1)
  have hbase : alpha ≤ ((firstEmptyCutBin alpha s halpha + 1 : ℕ) : ℝ) * alpha := by nlinarith
  exact hbase.trans hhigh

/-- Actual same-precision +1 numerical-word trajectory starting from native zero. -/
def addOneCounter (p : ℕ) (hp : 2 ≤ p) : ℕ → ℝ
  | 0 => 0
  | j + 1 => roundToEven p hp (addOneCounter p hp j + 1)

theorem addOneCounter_eq_natCast (p : ℕ) (hp : 2 ≤ p) (N : ℕ) (hN : N < 2 ^ p)
    {j : ℕ} (hj : j ≤ N) : addOneCounter p hp j = (j : ℝ) := by
  induction j with
  | zero => simp [addOneCounter]
  | succ j ih =>
      rw [addOneCounter, ih (by omega)]
      have hword : j + 1 < 2 ^ p := by omega
      simpa only [Nat.cast_add, Nat.cast_one] using roundToEven_natCast_of_lt_two_pow p hp hword

theorem addOneCounter_native (p : ℕ) (hp : 2 ≤ p) (j : ℕ) :
    Native p hp (addOneCounter p hp j) := by
  cases j with
  | zero => exact native_zero p hp
  | succ j => exact roundToEven_native p hp _

/-- Instrumentation counts only explicit rounded +1 additions, excluding
initialization, reads/writes, index work, scales, and all scan comparisons. -/
def addOneCounterWithCount (p : ℕ) (hp : 2 ≤ p) : ℕ → ℝ × ℕ
  | 0 => (0, 0)
  | j + 1 =>
      let previous := addOneCounterWithCount p hp j
      (roundToEven p hp (previous.1 + 1), previous.2 + 1)

theorem addOneCounterWithCount_eq (p : ℕ) (hp : 2 ≤ p) (j : ℕ) :
    addOneCounterWithCount p hp j = (addOneCounter p hp j, j) := by
  induction j with
  | zero => rfl
  | succ j ih => simp [addOneCounterWithCount, addOneCounter, ih]

/-- Rounded binary scaling of an actually generated integer word. -/
def nativeBinEndpoint (p : ℕ) (hp : 2 ≤ p) (e : ℤ) (j : ℕ) : ℝ :=
  roundToEven p hp (addOneCounter p hp j * (2 : ℝ) ^ e)

theorem nativeBinEndpoint_native (p : ℕ) (hp : 2 ≤ p) (e : ℤ) (j : ℕ) :
    Native p hp (nativeBinEndpoint p hp e j) := roundToEven_native p hp _

theorem nativeBinEndpoint_eq (p : ℕ) (hp : 2 ≤ p) (e : ℤ) (N : ℕ) (hN : N < 2 ^ p)
    {j : ℕ} (hj : j ≤ N) : nativeBinEndpoint p hp e j = (j : ℝ) * (2 : ℝ) ^ e := by
  rw [nativeBinEndpoint, addOneCounter_eq_natCast p hp N hN hj]
  exact roundToEven_eq_self_of_native (native_mul_zpow (native_natCast_of_lt_two_pow p hp (by omega)) e)

/-- Both selected-bin endpoints are exactly generated native words under k+2<2^p. -/
theorem firstEmptyCutBin_endpoints (p : ℕ) (hp : 2 ≤ p) {k : ℕ} (s : Fin k → ℝ) (e : ℤ)
    (hsize : k + 2 < 2 ^ p) :
    let alpha := (2 : ℝ) ^ e
    let j := firstEmptyCutBin alpha s (zpow_pos (by norm_num) e)
    nativeBinEndpoint p hp e j = (j : ℝ) * alpha ∧
      nativeBinEndpoint p hp e (j + 1) = ((j + 1 : ℕ) : ℝ) * alpha := by
  dsimp only
  have hj := (firstEmptyCutBin_spec ((2 : ℝ) ^ e) s (zpow_pos (by norm_num) e)).2.1
  exact ⟨nativeBinEndpoint_eq p hp e (k + 2) hsize (by omega),
    nativeBinEndpoint_eq p hp e (k + 2) hsize (by omega)⟩

end
end NumStability.FloatingPointFormat.UnboundedBinary
